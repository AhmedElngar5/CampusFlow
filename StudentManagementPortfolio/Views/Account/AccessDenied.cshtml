@{
    ViewData["Title"] = "Access Denied";
}

<div class="error-page">
    <div class="error-card">
        <div class="error-code text-danger">
            <i class="bi bi-shield-x"></i>
        </div>
        <div class="eyebrow text-danger">HTTP 403 · FORBIDDEN</div>
        <h1>Access Denied</h1>
        <p class="text-secondary">
            You do not have the required permissions to access this page or perform this action.
            Administrative privileges (<strong>Admin</strong> role) are required to create, edit, or delete student records.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="current-role-badge mb-4">
                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-person-badge me-1"></i>
                    Signed in as: <strong>@User.Identity.Name</strong>
                    @(User.IsInRole("Admin") ? "(Admin)" : User.IsInRole("Viewer") ? "(Viewer)" : "")
                </span>
            </div>
        }

        <div class="error-actions justify-content-center">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-custom">
                <i class="bi bi-grid-1x2 me-1"></i> Return to Dashboard
            </a>
            <a asp-controller="Students" asp-action="Index" class="btn btn-light-custom">
                <i class="bi bi-people me-1"></i> View Students Directory
            </a>
        </div>
    </div>
</div>

