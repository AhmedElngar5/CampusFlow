@model StudentManagementPortfolio.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Add New User";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">ADMINISTRATION / USERS</div>
        <h1>Add new user</h1>
        <p class="page-subtitle">Provision an account and assign administrative or viewer permissions.</p>
    </div>
    <a asp-action="Users" class="btn btn-light-custom">
        <i class="bi bi-arrow-left me-1"></i> Back to users
    </a>
</div>

<div class="section-card form-card">
    <div class="section-header">
        <div>
            <h2>User credentials &amp; permissions</h2>
            <p>Select role to grant appropriate system access.</p>
        </div>
        <span class="required-note">* Required fields</span>
    </div>

    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <div class="form-field full-width">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control form-control-custom" placeholder="user@school.edu" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-key"></i>
                    <input asp-for="Password" class="form-control form-control-custom" placeholder="Minimum 6 characters" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="Re-enter password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-field full-width">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select form-control-custom">
                    <option value="@StudentManagementPortfolio.Models.AppRoles.Viewer">Viewer (Read-only: can view dashboard, students directory, and export CSV)</option>
                    <option value="@StudentManagementPortfolio.Models.AppRoles.Admin">Admin (Full access: create, edit, delete students, manage accounts)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Users" class="btn btn-light-custom">Cancel</a>
            <button type="submit" class="btn btn-primary-custom">
                <span>Create user</span>
                <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

