@model StudentManagementPortfolio.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-brand-mark">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div class="eyebrow">PORTAL ACCESS</div>
            <h1>Welcome back</h1>
            <p class="page-subtitle">Sign in to manage student records and view school analytics.</p>
        </div>

        @if (ViewBag.NeedsSetup == true)
        {
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>
                    <strong>First-time setup required:</strong> No administrator exists yet.
                    <a asp-action="Setup" class="alert-link text-decoration-underline ms-1">Create initial administrator account &rarr;</a>
                </div>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control form-control-custom" placeholder="name@school.edu" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-key"></i>
                    <input asp-for="Password" class="form-control form-control-custom" placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-secondary small"></label>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2">
                <span>Sign in</span>
                <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <div class="auth-roles-info mt-4 pt-3 border-top">
            <span class="auth-roles-title"><i class="bi bi-people me-1"></i> Available Access Roles</span>
            <div class="row g-2 mt-1">
                <div class="col-6">
                    <div class="role-box">
                        <strong class="text-primary"><i class="bi bi-shield-check me-1"></i> Admin</strong>
                        <small class="d-block text-muted">Full student CRUD, export, and analytics</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="role-box">
                        <strong class="text-secondary"><i class="bi bi-eye me-1"></i> Viewer</strong>
                        <small class="d-block text-muted">Read-only records, export, and analytics</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

