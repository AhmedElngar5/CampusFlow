@model IReadOnlyList<StudentManagementPortfolio.Models.UserItemViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">ADMINISTRATION</div>
        <h1>User Management</h1>
        <p class="page-subtitle">Manage user accounts and role assignments for the school workspace.</p>
    </div>
    <div class="heading-actions">
        <a asp-action="CreateUser" class="btn btn-primary-custom">
            <i class="bi bi-person-plus me-1"></i> Add new user
        </a>
    </div>
</div>

<div class="section-card">
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th>USER</th>
                    <th>ASSIGNED ROLE</th>
                    <th>PERMISSION LEVEL</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state">
                                <div class="empty-icon"><i class="bi bi-people"></i></div>
                                <strong>No users registered</strong>
                                <p>Click above to provision user accounts.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    var isRoleAdmin = user.Roles.Contains("Admin");
                    <tr>
                        <td>
                            <div class="student-cell">
                                <div class="student-avatar bg-light text-dark">
                                    <i class="bi @(isRoleAdmin ? "bi-shield-check text-primary" : "bi-person text-secondary")"></i>
                                </div>
                                <div>
                                    <strong>@user.Email</strong>
                                    <small class="text-muted">Account ID: @user.Id[..8]...</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(isRoleAdmin ? "bg-primary" : "bg-secondary") px-2 py-1">
                                <i class="bi @(isRoleAdmin ? "bi-shield-lock" : "bi-eye") me-1"></i>@user.Roles
                            </span>
                        </td>
                        <td>
                            <small class="text-muted">
                                @(isRoleAdmin ? "Full access: CRUD, Analytics, Export, User Provisioning" : "Read-only: Directory, Analytics, CSV Export")
                            </small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

