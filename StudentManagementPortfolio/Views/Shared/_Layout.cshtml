@using Microsoft.AspNetCore.Identity
@using StudentManagementPortfolio.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-top">
                <a class="brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark">C</span>
                    <span>Campus<span class="brand-light">Flow</span></span>
                </a>
                <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Close menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="nav-caption">WORKSPACE</div>
            <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> <span class="link-text">Dashboard</span>
            </a>
            <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")" asp-controller="Students" asp-action="Index">
                <i class="bi bi-people"></i> <span class="link-text">Students</span>
            </a>

            @if (User.IsInRole(AppRoles.Admin))
            {
                <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" asp-controller="Account" asp-action="Users">
                    <i class="bi bi-shield-lock"></i> <span class="link-text">Users</span>
                </a>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                var roleLabel = User.IsInRole(AppRoles.Admin) ? "Admin" : User.IsInRole(AppRoles.Viewer) ? "Viewer" : "User";
                var initial = !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name[..1].ToUpperInvariant() : "U";

                <div class="sidebar-bottom">
                    <div class="avatar">@initial</div>
                    <div class="sidebar-user">
                        <strong class="text-truncate" style="max-width: 130px;" title="@User.Identity.Name">@User.Identity.Name</strong>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <span class="badge @(User.IsInRole(AppRoles.Admin) ? "bg-primary" : "bg-secondary")" style="font-size: 9px;">@roleLabel</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                        <button type="submit" class="btn btn-link text-secondary p-1" title="Sign out" style="text-decoration: none;">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="sidebar-bottom">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom w-100 justify-content-center">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                </div>
            }
        </aside>
        <div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>
        <main class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="hamburger d-lg-none" id="sidebarToggle" aria-label="Open menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <span class="topbar-label">SCHOOL MANAGEMENT</span>
                        <div class="topbar-title">Student Portal</div>
                    </div>
                </div>
                <div class="topbar-right">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var roleLabel = User.IsInRole(AppRoles.Admin) ? "Admin" : User.IsInRole(AppRoles.Viewer) ? "Viewer" : "User";
                        var initial = !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name[..1].ToUpperInvariant() : "U";

                        <span class="status-dot"></span>
                        <span class="small text-secondary d-none d-md-inline">System online</span>
                        <span class="badge @(User.IsInRole(AppRoles.Admin) ? "bg-primary" : "bg-secondary") ms-2 d-none d-sm-inline">@roleLabel</span>
                        <div class="avatar avatar-small" title="@User.Identity.Name">@initial</div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                            <button type="submit" class="btn btn-sm btn-light-custom py-1 px-2" title="Sign out">
                                <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Sign out</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary-custom py-1 px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                        </a>
                    }
                </div>
            </header>
            <div class="page-content">
                @if (TempData["Success"] is string successMsg)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@successMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMsg)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@errorMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
            <footer class="footer">
                CampusFlow <span>·</span> Student Management
                <span class="footer-right">© @DateTime.Now.Year · Portfolio project</span>
            </footer>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
