@model StudentManagementPortfolio.Models.StudentViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
    <div class="form-field full-width">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control form-control-custom" placeholder="e.g. Sarah Mohamed" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control form-control-custom" placeholder="student@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control form-control-custom" placeholder="01xxxxxxxxx" />
        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="Department" class="form-label"></label>
        <select asp-for="Department" class="form-select form-control-custom">
            <option value="">Select a department</option>
            <option>Computer Science</option>
            <option>Information Systems</option>
            <option>Artificial Intelligence</option>
            <option>Information Technology</option>
            <option>Business Administration</option>
        </select>
        <span asp-validation-for="Department" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="Year" class="form-label"></label>
        <select asp-for="Year" class="form-select form-control-custom">
            <option value="1">Year 1</option>
            <option value="2">Year 2</option>
            <option value="3">Year 3</option>
            <option value="4">Year 4</option>
            <option value="5">Year 5</option>
            <option value="6">Year 6</option>
            <option value="7">Year 7</option>
            <option value="8">Year 8</option>
        </select>
        <span asp-validation-for="Year" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<StudentStatus>()" class="form-select form-control-custom"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
    <div class="form-field">
        <label asp-for="EnrollmentDate" class="form-label"></label>
        <input asp-for="EnrollmentDate" type="date" class="form-control form-control-custom" />
        <span asp-validation-for="EnrollmentDate" class="text-danger small"></span>
    </div>
</div>
